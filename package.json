{
  "name": "floating-whiteboard",
  "productName": "Floating Whiteboard",
  "version": "1.7.0-beta.2",
  "description": "A fast, translucent, pen-first whiteboard for teaching and screen sharing",
  "main": "./out/main/index.js",
  "author": "SAMBHAV",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "electron-vite build && node e2e/run.mjs",
    "e2e:phase1": "electron-vite build && node e2e/phase1.mjs",
    "e2e:phase2": "electron-vite build && node e2e/phase2.mjs",
    "e2e:laser": "electron-vite build && node e2e/laser-audit.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never",
    "dist:signed": "electron-vite build && electron-builder --win --publish never --config.forceCodeSigning=true",
    "icon": "electron build/make-icon.cjs",
    "branding": "electron build/make-icon.cjs && electron build/render-branding.cjs",
    "dist:dir": "electron-vite build && electron-builder --win dir --publish never",
    "e2e:agent": "electron-vite build && node e2e/agent.mjs",
    "e2e:track-a": "electron-vite build && node e2e/track-a.mjs",
    "e2e:board": "electron-vite build && node e2e/board.mjs",
    "e2e:share": "electron-vite build && node e2e/share.mjs",
    "e2e:lesson": "electron-vite build && node e2e/lesson.mjs",
    "e2e:capture": "electron-vite build && node e2e/capture.mjs",
    "e2e:shelf": "electron-vite build && node e2e/shelf.mjs",
    "e2e:connectors": "electron-vite build && node e2e/connectors.mjs",
    "e2e:scale": "electron-vite build && node e2e/scale.mjs",
    "e2e:reveals": "electron-vite build && node e2e/reveals.mjs",
    "e2e:theme": "electron-vite build && node e2e/theme.mjs",
    "e2e:export": "electron-vite build && node e2e/export.mjs",
    "e2e:tools": "electron-vite build && node e2e/tools.mjs",
    "e2e:ink": "electron-vite build && node e2e/ink.mjs",
    "e2e:polish": "electron-vite build && node e2e/polish.mjs",
    "e2e:oneboard": "electron-vite build && node e2e/oneboard.mjs",
    "e2e:apparatus": "electron-vite build && node e2e/apparatus.mjs",
    "e2e:labels": "electron-vite build && node e2e/labels.mjs",
    "e2e:recognize": "electron-vite build && node e2e/recognize.mjs",
    "e2e:imports": "electron-vite build && node e2e/imports.mjs",
    "e2e:classroom": "electron-vite build && node e2e/classroom.mjs",
    "e2e:templates": "electron-vite build && node e2e/templates.mjs",
    "e2e:instruments": "electron-vite build && node e2e/instruments.mjs",
    "e2e:objects": "electron-vite build && node e2e/objects.mjs",
    "e2e:tables": "electron-vite build && node e2e/tables.mjs",
    "e2e:papers": "electron-vite build && node e2e/papers.mjs",
    "e2e:replay": "electron-vite build && node e2e/replay.mjs",
    "e2e:canvas": "electron-vite build && node e2e/canvas-audit.mjs",
    "e2e:grid": "electron-vite build && node e2e/square-grid.mjs",
    "e2e:science": "electron-vite build && node e2e/projectile.mjs",
    "e2e:library": "electron-vite build && node e2e/science-library.mjs",
    "e2e:showcases": "electron-vite build && node e2e/showcases.mjs",
    "dist:showcase": "electron-vite build && electron-builder --win --publish never --config.directories.output=dist/showcase-preview --config.nsis.artifactName=Floating-Whiteboard-Setup-${version}-showcase.exe --config.portable.artifactName=Floating-Whiteboard-Portable-${version}-showcase.exe",
    "dist:preview": "electron-vite build && electron-builder --win --x64 --publish never --config.directories.output=dist/windows-preview --config.nsis.artifactName=Floating-Whiteboard-Setup-${version}-x64.exe --config.portable.artifactName=Floating-Whiteboard-Portable-${version}-x64.exe",
    "e2e:icons": "electron-vite build && node e2e/icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "lucide-preact": "^1.0.0",
    "mathjax-full": "3.2.2",
    "mediabunny": "1.61.3",
    "pdfjs-dist": "4.10.38",
    "perfect-freehand": "^1.2.0",
    "preact": "^10.27.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "playwright": "^1.50.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.sambhav.floating-whiteboard",
    "productName": "Floating Whiteboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Floating Whiteboard"
    },
    "portable": {
      "artifactName": "Floating-Whiteboard-portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "node_modules/qrcode/license",
        "to": "notices/qrcode.txt"
      },
      {
        "from": "node_modules/dijkstrajs/LICENSE.md",
        "to": "notices/dijkstrajs.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "notices",
        "to": "notices"
      },
      {
        "from": "mcp/whiteboard-mcp.cjs",
        "to": "mcp/whiteboard-mcp.cjs"
      }
    ]
  }
}
